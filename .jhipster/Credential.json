{
  "annotations": {
    "changelogDate": "20260529175232"
  },
  "applications": ["*"],
  "documentation": "A signed SD-JWT Verifiable Credential held by one Investec customer.\\nsdJwt stores the full compact serialisation; it is never sent back to\\nthe client in list views — only on explicit single-credential fetch.",
  "dto": "mapstruct",
  "fields": [
    {
      "fieldName": "holderLogin",
      "fieldType": "String",
      "fieldValidateRules": ["required", "maxlength"],
      "fieldValidateRulesMaxlength": "50"
    },
    {
      "fieldName": "title",
      "fieldType": "String",
      "fieldValidateRules": ["required", "maxlength"],
      "fieldValidateRulesMaxlength": "120"
    },
    {
      "fieldName": "purpose",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "200"
    },
    {
      "fieldName": "status",
      "fieldType": "CredentialStatus",
      "fieldValidateRules": ["required"],
      "fieldValues": "ACTIVE,REVOKED,EXPIRED"
    },
    {
      "fieldName": "issuedAt",
      "fieldType": "Instant",
      "fieldValidateRules": ["required"]
    },
    {
      "fieldName": "expiresAt",
      "fieldType": "Instant",
      "fieldValidateRules": ["required"]
    },
    {
      "fieldName": "issuerDid",
      "fieldType": "String",
      "fieldValidateRules": ["required", "maxlength"],
      "fieldValidateRulesMaxlength": "200"
    },
    {
      "fieldName": "sdJwt",
      "fieldType": "TextBlob",
      "fieldValidateRules": ["required"]
    },
    {
      "documentation": "Comma-separated short claim labels for list-view display only.",
      "fieldName": "claimsSummary",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "500"
    },
    {
      "fieldName": "vcRef",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "200"
    }
  ],
  "jpaMetamodelFiltering": true,
  "name": "Credential",
  "pagination": "pagination",
  "relationships": [
    {
      "otherEntityName": "issuedClaim",
      "otherEntityRelationshipName": "credential",
      "relationshipName": "claims",
      "relationshipSide": "left",
      "relationshipType": "one-to-many"
    }
  ],
  "searchEngine": "no",
  "service": "serviceClass"
}
